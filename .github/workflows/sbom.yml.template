# ─────────────────────────────────────────────────────────────────────────────
# SCAFFOLD — INERT TEMPLATE (NOT ACTIVE). Sprint S2 DevSecOps/SSDLC.
#
# This file has a `.template` suffix on purpose: GitHub Actions does NOT pick up
# `*.yml.template`, so this workflow does NOT run, adds NO required gate, and does
# NOT weaken any existing guardian. ACTIVATION AWAITS OPERATOR.
#
# To activate (operator decision — see docs/governance/DEVSECOPS-SSDLC.md §9 O-6):
#   1. Confirm scope (which artifacts/images to inventory) and runner perimeter
#      (must respect ADR-117: no project/customer data on the factory).
#   2. Rename:  sbom.yml.template  →  sbom.yml
#   3. Pin syft to a fixed version (Config-over-Hardcoding, CLAUDE.md §10).
#
# Purpose: generate a CycloneDX SBOM (syft) and publish it as a build artifact.
# Anchors: docs/governance/DEVSECOPS-SSDLC.md (G-S2-01, §5); §5.2 target model.
# ─────────────────────────────────────────────────────────────────────────────
name: sbom (SCAFFOLD — INACTIVE)

on:
  workflow_dispatch:   # manual only once activated; no PR/push triggers in scaffold

permissions:
  contents: read

jobs:
  sbom:
    name: sbom-cyclonedx
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Generate CycloneDX SBOM (syft)
        uses: anchore/sbom-action@v0
        with:
          path: .
          format: cyclonedx-json
          output-file: sbom.cyclonedx.json
          # syft version pinning AWAITS OPERATOR (Config-over-Hardcoding §10)

      - name: Upload SBOM artifact
        uses: actions/upload-artifact@v4
        with:
          name: sbom-cyclonedx
          path: sbom.cyclonedx.json
