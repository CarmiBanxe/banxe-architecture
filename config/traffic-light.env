# ─────────────────────────────────────────────────────────────────────────────
# Traffic-light ("Светофор") audit — CONFIG-AS-DATA (CLAUDE.md §10, no hardcoded
# limits in scripts/traffic-light.sh). Shell-sourceable key=value (no parser dep).
# Sprint S-FAC-65 (R1) — FACTORY-ROADMAP-2026-06-23.md §4.2.
#
# All thresholds / endpoints / criticality live HERE, never in the script.
# Operator tunes endpoints + timeouts on the host; the script reads this verbatim.
# ─────────────────────────────────────────────────────────────────────────────

# --- Probe targets: one per line in TL_TARGETS, fields "NAME|KIND|TARGET|CRITICALITY"
#     KIND        ∈ http | tcp | redis | cmd
#     CRITICALITY ∈ critical (fail ⇒ service RED) | noncritical (fail ⇒ service YELLOW)
#     Endpoints are placeholders pending operator confirmation (host-side, AWAITS OPERATOR).
TL_TARGETS="
legion-redis|redis|127.0.0.1:6379|critical
evo1-control-plane|http|http://evo1:9207/health|critical
evo2-observability|http|http://evo2:9090/-/healthy|noncritical
evo2-inference|http|http://evo2:9208/health|noncritical
fabric-stream|cmd|redis-cli -h 127.0.0.1 XLEN fabric:heartbeat:evo1|noncritical
"

# --- Per-probe timeout (seconds). Read-only probes only; never mutate a service.
TL_PROBE_TIMEOUT_SEC=5

# --- Redis fabric streams (S-FAC-62 channel convention: fabric:<type-with-colons>,
#     docs/runbooks/bus-redis-streams-2026-06-17.md). Verdicts are PUBLISHED here.
TL_REDIS_HOST=127.0.0.1
TL_REDIS_PORT=6379
TL_VERDICT_STREAM=fabric:audit:verdict
# Session-start trigger stream the redis hook blocks on (ad-hoc on-demand audit).
TL_SESSION_STREAM=fabric:session:start

# --- Runtime verdict-shard output dir (per-run append-only shard; host-side).
#     In --self-test this is IGNORED (nothing written to the repo ledger).
TL_VERDICT_SHARD_DIR=ledger/entries/traffic-light-verdicts

# --- Schedule (artifact only; operator installs the crontab — see deploy/cron/).
TL_CRON_TZ=Europe/Berlin   # CEST/CET
TL_CRON_TIMES="08:00,20:00"

# --- DORA binding (READ-ONLY reference; NO live collection here — that is
#     S-FAC-68 / AWAITS OPERATOR per KPI-DORA-FRAMEWORK §4.2/§5). The verdict
#     cadence + RED→GREEN transitions FEED these targets downstream; the script
#     does not compute or enforce them.
#     D-1 Deployment Frequency  ≥ 1 deploy/day per squad   (GREEN cadence proxy)
#     D-2 Lead Time for Changes < 1 day
#     D-3 Change Failure Rate   ≤ 15%                       (RED→GREEN transitions)
#     D-4 MTTR                  < 1 hour                    (RED→GREEN transitions)
TL_DORA_REF="D-1:>=1/day/squad D-2:<1d D-3:<=15% D-4:<1h"
