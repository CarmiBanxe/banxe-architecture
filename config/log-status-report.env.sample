# config/log-status-report.env.sample
#
# Sample EnvironmentFile for systemd/log-status-report.service (Type=oneshot).
# Copy to ~/.config/banxe/log-status-report.env on the target host, adjust
# values, chmod 0600. NEVER commit the populated file.
#
# All four knobs mirror the script's documented defaults in
# scripts/log-status-report.sh — override only what you need.
#
# NO SECRETS in this file. The report is fully read-only ops metadata.

# Shell glob for input logs (script uses nullglob, so no-match => empty list).
LOG_GLOB=/tmp/sp*-*.log

# Absolute path to the markdown output. The script writes atomically
# (mktemp in-dir + mv -f), so no partial file ever exists at the target.
STATUS_PATH=/home/banxe/banxe-dev/DISPATCH-STATUS.md

# A log without a finish marker (regex '^\[[A-Z].*=.*\]') whose mtime is
# older than STALE_SECS seconds is classified INCOMPLETE. Younger =>
# IN_PROGRESS. Default 30 minutes.
STALE_SECS=1800

# pgrep -c -f pattern used to report active-job count in the report header.
# The script ONLY counts; it never signals or inspects processes further.
# No committed default (config-over-hardcoding). Set to the command line
# that runs your background jobs on THIS host — this file is never
# committed. When unset, the report line shows 'n/a (JOB_MATCH unset)'.
JOB_MATCH='<your-runner-process-pattern>'
