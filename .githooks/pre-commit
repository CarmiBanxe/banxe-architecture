#!/bin/bash
# LucidShark pre-commit quality scan
# BUG-006 fix: prevent AI-generated code issues from reaching commit

# ── ADR-120: per-session git-worktree isolation ──
# Refuse commits from the shared/main checkout. A linked session worktree's git-dir
# lives under .git/worktrees/ (portable detection, no hardcoded path); the shared
# checkout's does not. One session = one worktree off origin/main (see scripts/bx-session.sh).
case "$(git rev-parse --absolute-git-dir 2>/dev/null || echo /)" in
  */worktrees/*) : ;;  # linked session worktree — allowed
  *)
    echo "❌ ADR-120 violation: commit from the shared/main checkout is forbidden (audit-only)."
    echo "   One session = one git worktree off origin/main:"
    echo "     bash scripts/bx-session.sh agent/<central|right|factory>/<id>/<slug>"
    exit 1 ;;
esac

# ── ADR-121 RULE 7: no destructive ops against shared/foreign state ──
# (a) BLOCK staging of git-internal / worktree-admin paths — never a legitimate
#     commit, so zero false-positives on normal commits.
if git diff --cached --name-only | grep -Eq '(^\.git/|/worktrees/)'; then
  echo "❌ ADR-121 RULE 7: refusing to commit git-internal / worktree-admin paths (.git/, */worktrees/)."
  echo "   These are never committed; check your staged set (git diff --cached --name-only)."
  exit 1
fi
# (b) WARN (non-blocking) if a staged *shell script* ADDS a destructive pattern targeting
#     shared/foreign state. Scoped to *.sh added lines ⇒ does not false-block docs that merely
#     mention these patterns, nor normal commits. Advisory only — never exits non-zero.
_adr121_danger='(rm[[:space:]]+-[a-zA-Z]*r[a-zA-Z]*f|git[[:space:]]+worktree[[:space:]]+(remove|prune)|git[[:space:]]+branch[[:space:]]+-D|git[[:space:]]+push[[:space:]].*--delete|chattr[[:space:]].*\.git)'
for _f in $(git diff --cached --name-only --diff-filter=ACM -- '*.sh' 2>/dev/null); do
  if git diff --cached -- "$_f" | grep -E '^\+' | grep -Eiq "$_adr121_danger"; then
    echo "⚠️  ADR-121 RULE 7 (advisory): '$_f' adds a destructive pattern (rm -rf / git worktree remove|prune / branch -D / push --delete / chattr .git)."
    echo "   Cleanup is limited to the session's OWN worktree; never act on shared/foreign state. See ADR-121 + .claude/rules/parallel-session-isolation.md Rule 7."
  fi
done

echo "🔍 Running LucidShark scan..."

# Check if lucidshark is available
if command -v lucidshark &> /dev/null; then
    lucidshark scan --fail-on=critical
    if [ $? -ne 0 ]; then
        echo "❌ LucidShark found critical issues. Fix before committing."
        exit 1
    fi
else
    echo "⚠️ LucidShark not installed. Running semgrep fallback..."
    if command -v semgrep &> /dev/null; then
        semgrep scan --config=auto --error --severity=ERROR
        if [ $? -ne 0 ]; then
            echo "❌ Semgrep found critical issues. Fix before committing."
            exit 1
        fi
    fi
fi

echo "✅ Quality scan passed"
