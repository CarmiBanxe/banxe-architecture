# systemd/novelty-watcher.service
# B->A novelty auto-handoff pipeline — factory-watcher v1.1 (PROPOSED template).
#
# STATUS: IN-REPO TEMPLATE ONLY. NOT INSTALLED. NOT ENABLED. NOT STARTED.
#
# Install venue = evo1 (ADR-103 server-only build venue), NOT Legion.
# Legion is thin-client per Operator canon Principle 1.
#
# Install sequence (operator, HITL — CLAUDE.md §71 / ADR-156 sandbox posture):
#   ssh evo1
#   # place a copy of this unit + the .timer under ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable  novelty-watcher.timer
#   systemctl --user start   novelty-watcher.timer
# The watcher daemon MUST NOT be activated autonomously by any agent.
#
# EnvironmentFile carries the LiteLLM master key (env var LITELLM_KEY) used
# by the v2 semantic-scoring hook (v1.1 is stub-only and does not deref it).
# The path below is a PLACEHOLDER; the operator populates the real file
# OUTSIDE the repo, with mode 0600, before enabling the timer. The env file
# is NEVER committed to git. This unit itself contains NO literal keys.
#
# WorkingDirectory / ExecStart resolve %h to the evo1 operator home, anchored
# to %h/banxe-architecture — the shared checkout on evo1 (ADR-103). The
# watcher script itself then spawns/reuses a dedicated linked worktree via
# scripts/bx-session.sh (ADR-120) and writes there ONLY — never mutating the
# shared checkout (parallel-session-isolation Rule 6). This is a v1.1 fix
# for the v1 shakeout defect where the watcher wrote into the shared tree.
#
# Anchors: ADR-159 (B->A pipeline), ADR-103 (server-only build venue = evo1),
# ADR-120 (per-session worktree isolation), ADR-156 (sandbox),
# CLAUDE.md §71 (HITL merge), safety-rules.md (destructive-op verify-step),
# .claude/rules/parallel-session-isolation.md Rule 6 + Rule 7.

[Unit]
Description=Banxe factory-watcher — B->A novelty auto-handoff (v1.1 PROPOSED, template, evo1)
Documentation=file:%h/banxe-architecture/docs/adr/ADR-159-ba-novelty-auto-handoff-pipeline.md
# Do not start on boot; timer-driven only.
ConditionPathExists=%h/banxe-architecture/scripts/novelty-watcher.sh

[Service]
Type=oneshot

# WorkingDirectory / ExecStart anchor to the evo1 shared checkout at
# %h/banxe-architecture. The script then spawns/reuses an isolated linked
# worktree at $HOME/wt/... via scripts/bx-session.sh (ADR-120) and writes
# only there. This unit itself does NOT mutate the shared checkout.
WorkingDirectory=%h/banxe-architecture
ExecStart=%h/banxe-architecture/scripts/novelty-watcher.sh

# EnvironmentFile carries LITELLM_KEY (env-only; the file is OUTSIDE the repo
# and never committed). Path below is a placeholder for the operator to
# populate on evo1 with mode 0600 before enabling the timer. The unit file
# ITSELF contains NO literal keys. v1.1 is stub-only and does NOT dereference
# the key — the v2 semantic-scoring hook will require it for real scoring.
EnvironmentFile=-%h/.config/banxe/novelty-watcher.env

# Fail-closed: any non-zero exit stops the run; the timer will retry on its
# next tick. No silent retries past a stop-barrier (ADR-159 §D-5).
StandardOutput=journal
StandardError=journal

# Sandbox hardening — read-write only within the working tree AND the
# isolated-worktree parent (~/wt), which the script uses via bx-session.sh.
# No network writes beyond git-fetch (performed by the script itself).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/banxe-architecture %h/wt

[Install]
# Wanted-by intentionally omitted for the .service — activation is via the
# .timer only. Direct `systemctl start novelty-watcher.service` is possible
# for one-shot manual runs by the operator on evo1, but is NOT part of the
# scaffolded activation path.
